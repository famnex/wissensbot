# Innerhalb eines bereits mit gültigem TLS-Zertifikat eingerichteten server-Blocks.
# server_name und Zertifikat über die bestehende Serververwaltung einrichten.
# APP_ORIGIN muss exakt https://wissen.example.org sein.

client_max_body_size 21m;

location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Genau ein vertrauenswürdiger Proxy; eingehende Forwarded-Ketten überschreiben.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_read_timeout 240s;
    proxy_send_timeout 120s;
    proxy_buffering off;
}
