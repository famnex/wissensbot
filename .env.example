# Kopieren nach .env und vor dem Start ausfüllen. Niemals echte Secrets committen.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://wissen.example.org
# Ein Reverse Proxy direkt vor dieser App. Der Port darf nicht öffentlich erreichbar sein.
TRUST_PROXY_HOPS=1
DATA_DIR=/var/lib/wissensraum

# Einmal erzeugen: openssl rand -hex 32
# Dauerhaft und separat von den DB-Backups aufbewahren.
APP_ENCRYPTION_KEY=

# Modus: jwks | public_key | secret
JWT_MODE=jwks
JWT_ALGORITHM=RS256
JWT_ISSUER=https://identity.example.org/
JWT_AUDIENCE=wissensraum
JWT_JWKS_URL=https://identity.example.org/.well-known/jwks.json
# Für public_key: absoluter Pfad zu einem SPKI-Public-Key (PEM).
JWT_PUBLIC_KEY_FILE=
# Nur für secret + HS256; mindestens 32 zufällige Bytes, vom IdP vorgegeben.
JWT_SECRET=
JWT_MAX_AGE_SECONDS=86400
# Optional: vorhandener Organisationslogin, der den JWT-Handoff unterstützt.
AUTH_LOGIN_URL=

UPLOAD_MAX_MB=20
CRAWL_MAX_PAGES=40
RAG_MIN_SCORE=0.3

# Nach Einrichtung des Git-Checkouts und aller drei PM2-Prozesse aktivieren.
ALLOW_UPDATES=false
UPDATE_REPOSITORY=https://github.com/OWNER/REPOSITORY.git
UPDATE_BRANCH=main
PM2_APP_PREFIX=wissensraum

# Alternativ .env außerhalb des Repos speichern und CONFIG_FILE beim Start setzen.
# CONFIG_FILE=/etc/wissensraum/app.env
